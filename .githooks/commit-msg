#!/usr/bin/env bash
# Commit message check: D<day> <Regular|Home> Meet: <what changed>
#   - day goes up by 1 when the date changed since the last D commit (past 12 am), else stays the same
#   - merges are allowed (including plain `git pull` merges)
#
# Setup, once per clone:  git config core.hooksPath .githooks
#
# CI (.github/workflows/commit-messages.yml) runs this for each pushed commit with
# CHECK_BASE (the commit's parent), CHECK_MERGE (1 for merge commits) and
# CHECK_DATE (the commit's author date, YYYY-MM-DD in its own timezone) set.

msg_file="$1"
base="${CHECK_BASE:-HEAD}"
today="${CHECK_DATE:-$(date +%F)}"

if [ -n "${CHECK_MERGE+x}" ]; then
  is_merge="$CHECK_MERGE"
elif git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  is_merge=1
else
  is_merge=0
fi

subject=$(grep -v '^#' "$msg_file" | grep -m1 -v '^[[:space:]]*$')

fail() {
  echo "" >&2
  echo "Bad commit message: $1" >&2
  echo "  Message: $subject" >&2
  echo "  Format:  D<day> <Regular|Home> Meet: <what changed>" >&2
  echo "  Example: D10 Regular Meet: fix mirroring" >&2
  [ -n "$2" ] && echo "$2" >&2
  echo "" >&2
  exit 1
}

if [ "$is_merge" = 1 ]; then
  exit 0
fi

if ! printf '%s\n' "$subject" | grep -Eq '^D[0-9]+ (Regular|Home) Meet: [^ ]'; then
  fail "doesn't match the team format."
fi

day=${subject#D}
day=${day%% *}

last_line=$(git log --first-parent --format='%ad %s' --date=short -n 300 "$base" 2>/dev/null | grep -Em1 '^[0-9-]+ D[0-9]+ ')
if [ -n "$last_line" ]; then
  last_date=${last_line%% *}
  last_subject=${last_line#* }
  last=${last_subject#D}
  last=${last%% *}
  if [ "$today" = "$last_date" ]; then
    want=$((10#$last))
    why="same date as the last D commit ($last_date), so same day"
  else
    want=$((10#$last + 1))
    why="new date since the last D commit ($last_date), so next day"
  fi
  if [ $((10#$day)) -ne "$want" ]; then
    fail "day should be D$want, not D$day: $why." \
"  Last commit: $last_subject"
  fi
fi

exit 0
